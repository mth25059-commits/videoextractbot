# ===========================================================================
# Copy this file to `.env` and fill it in.  `.env` is gitignored — real values
# never reach GitHub.  Never paste a real token into any tracked file.
# ===========================================================================

# --- TELEGRAM ----------------------------------------------------------------
# From https://my.telegram.org  →  API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather.  If this token has ever been shared or committed, run
# /revoke in @BotFather and paste the fresh one here.
BOT_TOKEN=

# Your own Telegram numeric user id.  Comma-separate for multiple admins.
ADMIN_IDS=6100000001

# Optional: a private channel/group id where every job is logged (bot must be
# an admin there).  Leave blank to disable.
LOG_CHAT_ID=

# --- CREDITS -----------------------------------------------------------------
FREE_CREDITS_ON_JOIN=2
MIN_TOPUP_RUPEES=20

# What ₹1 buys.  This is the number to change, and the one the bot shows people:
# 1.5 means ₹20 tops up 30 credits.  (RUPEES_PER_CREDIT is the old spelling of the
# same fact, upside down; it is still read for a box that has it set, but this key
# wins when both are present.)
CREDITS_PER_RUPEE=1.5

# The price of **one video**, not one link.  A folder link holding ten videos is
# charged ten times this — the floor is taken when the batch is confirmed and the
# rest once the folder has been read, so nothing is held for videos that turn out
# not to be there.
COST_TERABOX_PER_LINK=0.5
COST_ZIP_UPTO_1GB=2
COST_ZIP_UPTO_2GB=4

# The 🔥 Fap ladder — one price per quality the video is offered at.  Only the
# rungs a video actually has are shown, so these are prices and not promises, and
# a video with no 1080p copy is never charged for one.  Halves are fine: credits
# are stored as a real number.
COST_FAP_480=1
COST_FAP_720=1.5
COST_FAP_1080=2

MAX_LINKS_PER_BATCH=10

# --- WORKER LIMITS -----------------------------------------------------------
# Two independent lanes, because the two services are limited by different
# things: a Terabox download is capped by Terabox's own per-CDN-host shaping
# (~1.5 MB/s a stream), while a ZIP job pulls from Telegram, unpacks locally and
# uploads without touching Terabox at all.  They drain side by side, so four
# archives no longer block three link jobs.
#
# Raising these does not make any single download faster.  It is so that six
# people all START at once instead of watching a queue — which is the part that
# actually feels slow.  The ceiling is disk, not bandwidth: see WORK_DIR.
MAX_CONCURRENT_JOBS=6
MAX_CONCURRENT_ZIP_JOBS=4

# Telegram MTProto ceiling.  2000 MB for a normal account, 4000 with Premium.
MAX_UPLOAD_MB=2000

# Scratch space.  A job can hold two files at once (a download and its remux
# target, or an archive and the video being pulled out of it), so size this at
# (MAX_CONCURRENT_JOBS + MAX_CONCURRENT_ZIP_JOBS) x MAX_UPLOAD_MB x 2.  Below
# MAX_UPLOAD_MB x 2.5 free the queue makes new jobs wait rather than filling the
# disk and failing several of them at once.
WORK_DIR=./downloads

# Nightly health report to every ADMIN_IDS, as HH:MM in UTC.  The box runs on UTC
# and is read in IST, which is UTC+5:30 with no daylight saving — so midnight IST
# is 18:30 UTC.  Leave it blank to send no report; the admin panel's "Send Report"
# button works either way.
DAILY_REPORT_UTC=18:30

# --- PAYMENT SERVICE ---------------------------------------------------------
# The Node UPI gateway (paysvc/) listens here.  127.0.0.1 ONLY — this port must
# never be reachable from the internet.
PAYSVC_URL=http://127.0.0.1:4400

# Shared secret between bot and paysvc.  Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
PAYSVC_SECRET=

# Port the bot listens on for the paysvc "order paid" callback.
PAID_CALLBACK_PORT=8081

# How long a QR stays valid before the order expires, in minutes.
PAYMENT_WINDOW_MINUTES=10

# --- TERABOX -----------------------------------------------------------------
# Your own logged-in cookie.  A signed-out session can read a share but is never
# given a download link, so this is what turns a listing into an actual file.
# Sign in at terabox.com in a browser, open DevTools → Application → Cookies, and
# copy the value of `ndus`.  Either form works:
#   TERABOX_COOKIE=ndus=Y1abc...
#   TERABOX_COOKIE=Y1abc...
# It is the account whose bandwidth is used, and it expires — if links suddenly
# stop resolving, this is the first thing to replace.
#
# Terabox hands an `ndus` to guests too, so its presence proves nothing.  To check
# the one you copied is really signed in, open this in the same browser:
#   https://www.terabox.com/api/quota?checkfree=1
# Storage numbers means signed in; `user not login` means that cookie is a guest.
# The session is also bound to whichever host Terabox redirects you to — the bot
# finds that host itself, so copy the cookie from wherever you are logged in and
# do not log out of that browser afterwards.
TERABOX_COOKIE=

# Spare cookies, one per numbered key, up to TERABOX_COOKIE_6.  Each should be a
# different Terabox account.
#
# These buy FAILOVER, NOT SPEED.  Terabox limits how fast it serves a file per CDN
# host, not per account — measured 4 September 2026 — so a second cookie does not
# make any download quicker.  What it does is keep the bot working when the first
# account is rate-limited (`errno 400210`) or has been logged out, which one cookie
# cannot survive at all: the bot moves to the next one and the user sees nothing.
#
# Numbered keys rather than one comma-separated list on purpose — a cookie value
# legitimately contains `=` and `;`, and splitting on commas would shred it into
# halves that are each a broken cookie.  Order matters: TERABOX_COOKIE is tried
# first, then 2, 3, …  Leave the ones you do not have blank.
TERABOX_COOKIE_2=
TERABOX_COOKIE_3=
TERABOX_COOKIE_4=
TERABOX_COOKIE_5=
TERABOX_COOKIE_6=

# A share link can point at a folder.  One link is one credit however many files
# are inside, so this caps how many a single credit can pull.
TERABOX_MAX_FILES_PER_LINK=10

# The cookieless route, for when TERABOX_COOKIE is empty or has expired: the link
# is sent to the third-party resolver iteraplay.com, which hands back the original
# file at full quality (measured byte-for-byte against what Terabox reports).  On
# by default, because with it off and no cookie the bot cannot fetch anything.
# Turn it off if links must never leave your own servers.  Two things it costs:
# every link handled this way is disclosed to iteraplay, and a caller with no
# account there gets five videos per six hours before a 429.
TERABOX_FALLBACK=true

# Optional: iteraplay `login_token`s for accounts you registered yourself, comma
# separated.  The five-per-six-hours limit is counted per account, so each one you
# add raises the ceiling.  Sign in at iteraplay.com, then copy the `login_token`
# cookie.  Leave blank to stay a guest.  Do not paste someone else's token here.
# Check a token is actually live before trusting it: an expired one is not
# refused, it is simply treated as a guest.
TERABOX_FALLBACK_TOKENS=

# How many (account, proxy) pairs one link may be tried through before the user is
# told the quota is spent.  Raising this multiplies requests to someone else's API:
# a ten-link batch at 4 is already up to forty.
TERABOX_FALLBACK_ATTEMPTS=4

# --- COMING-SOON BUTTON ------------------------------------------------------
# Shows an extra service button on the main menu that only replies "not
# available yet".  It downloads nothing and charges nothing.
SHOW_SOON_BUTTON=false
SOON_BUTTON_LABEL=🔥  Fap

# --- FAP RESOLVER ------------------------------------------------------------
# The operator's own resolver: it takes one video page and answers with every
# quality that video has.  There is a default in the source, so this only needs
# setting if the endpoint moves — that is the whole reason it is a variable rather
# than being hardcoded, so a moved address is one line here and not a redeploy.
#
# Leaving it BLANK switches the 🔥 key off politely: it answers "not switched on
# yet" and charges nobody, rather than failing on a link.
#
# Every quality it returns is an HLS playlist, not a finished file, so ffmpeg
# assembles it before Telegram will take it — which is why the size cannot be
# known until it is done, and why a very large video arrives split into parts.
FAP_API=https://resolver.example/api/faphouse/mrx

# --- OPTIONAL: OUTBOUND PROXIES ---------------------------------------------
# Your own proxies only.  One per line-equivalent, comma separated.
# Format: http://user:pass@host:port
# Leave blank to connect directly.
#
# Used for two different things:
#
# 1. The cookieless route spreads its attempts across them, because iteraplay
#    counts its quota per calling address as well as per account.
# 2. Terabox downloads leave from a different address per job, round-robin, with
#    direct egress as one slot in the rotation.  Measured 4 September 2026: three
#    links at once total 3.11 MB/s direct and 3.92 MB/s with one address each — a
#    1.26x gain on AGGREGATE throughput.  It does NOT make a single download
#    faster (splitting one file across four routes was 1.03x); what it does is let
#    several people download at once and spread ban and quota risk.
#
# Order matters — the list is walked in order — and a slow proxy is worse than
# none: two of ten measured addresses carried 0.25-0.36 MB/s against a 1.38 MB/s
# direct baseline.  Time yours and simply leave the slow ones out.  A proxy that
# fails a download is benched for ten minutes and the job is retried directly, so
# a bad entry costs time, never a job.
#
# A lapsed proxy plan answers CONNECT with 402 Payment Required and every route is
# dead at once — that status is the tell for a list that needs replacing rather
# than debugging.  The admin card can probe the whole list and show which survive.
PROXIES=
