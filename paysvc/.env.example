# ===========================================================================
# You probably do not need this file.
#
# paysvc reads `paysvc/.env` first and then the bot's own `../.env`, and the
# first file to set a key wins.  Normally every value lives in the bot's `.env`
# — one file to fill in, and one place a mistyped PAYSVC_SECRET can hide.
#
# Copy this to `paysvc/.env` only when paysvc runs somewhere the bot's `.env`
# is not, or when you want to point a test instance at a different inbox.
# ===========================================================================

# --- must match the bot, exactly ---------------------------------------------
# The bot rejects a callback signed with anything else, and paysvc rejects a
# request from anything that does not know it.
PAYSVC_SECRET=

# Where paysvc listens.  127.0.0.1 only — anything that can reach this port can
# quote amounts and read order state.  Never put it behind nginx.
PAYSVC_URL=http://127.0.0.1:4400

# Where the bot listens for the "order paid" push.
PAID_CALLBACK_PORT=8081

# --- where the money goes ----------------------------------------------------
UPI_ID=
UPI_PAYEE_NAME=

# Prefix on the reference printed with each order.  Cosmetic.
PAYMENT_REF_PREFIX=TB

# --- the inbox that confirms payments ----------------------------------------
# A Gmail app password, not the account password.  Blank switches automatic
# confirmation off: orders are still quoted, they just never settle by themselves.
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_SENDER=no-reply@famapp.in
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_HOURS=12
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- timing ------------------------------------------------------------------
PAYMENT_WINDOW_MINUTES=10
PAYMENT_GRACE_MINUTES=30

# --- storage -----------------------------------------------------------------
# The order journal.  paysvc/data/ is gitignored; it holds no card details and
# no credentials, only order ids, amounts and bank references.
PAYSVC_JOURNAL=./data/orders.json
